@page
@model IndexModel
@{
    ViewData["Title"] = "Lab 2: Data & Databases";
}

<div class="page-hero hero-blue">
    <div style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.5rem;">
        <span class="step-pill pill-teal">@Model.ModuleName</span>
        <span class="step-pill">Completed Lab</span>
    </div>
    <h1>@Model.LabTitle</h1>
    <p class="lead">
        Explore a data-driven Razor Pages application that uses Entity Framework Core and SQLite to retrieve, search, and display staff records.
    </p>
    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.25rem;">
        <a asp-page="/Staff/Index" class="btn btn-primary">Open Staff Directory &rarr;</a>
        <a href="https://github.com/mustbebuilt/webdev-razor-lab2-data/wiki" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
            📖 Read the Lab Guide
        </a>
    </div>
</div>

<div class="alert alert-success">
    The application is connected to its SQLite database. Browse the staff directory to search the sample records and view individual profiles.
</div>

<h2>Explore the completed features</h2>
<div class="demo-grid">
    <div class="demo-card">
        <div class="demo-card-header">
            <span class="step-pill pill-teal">SQLite &amp; EF Core</span>
            <h3>Staff Directory</h3>
        </div>
        <p>
            Staff records are loaded from SQLite through Entity Framework Core. Search by last name with the GET search form.
        </p>
        <a asp-page="/Staff/Index" class="btn btn-outline btn-sm">Browse Staff &rarr;</a>
    </div>

    <div class="demo-card">
        <div class="demo-card-header">
            <span class="step-pill">Route Parameters</span>
            <h3>Staff Details</h3>
        </div>
        <p>
            Open a staff member from the directory to see their contact information, department, role, salary, and status.
        </p>
        <a asp-page="/Staff/Index" class="btn btn-outline btn-sm">Choose a Staff Member &rarr;</a>
    </div>

    <div class="demo-card">
        <div class="demo-card-header">
            <span class="step-pill pill-amber">LINQ &amp; Model Binding</span>
            <h3>Search the Data</h3>
        </div>
        <p>
            The directory binds the search term from the query string and applies a deferred LINQ filter before loading matching records.
        </p>
        <a asp-page="/Staff/Index" class="btn btn-outline btn-sm">Try a Search &rarr;</a>
    </div>
</div>
